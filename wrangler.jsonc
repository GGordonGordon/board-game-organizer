{
  // Cloudflare Workers config: serve the built Vite app as static assets.
  // Deployed by Workers Builds on push (build: npm run build, deploy: npx wrangler deploy).
  "name": "board-game-organizer",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Single canonical hostname (mirrored by SITE_URL in src/site.ts). Cloudflare
  // creates the DNS record and TLS cert automatically on deploy; the
  // ggordongordon.com zone is registered on this same Cloudflare account.
  "routes": [
    { "pattern": "board-game-organizer.ggordongordon.com", "custom_domain": true }
  ]
}
